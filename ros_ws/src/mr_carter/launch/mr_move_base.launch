<launch>
  <!-- Arguments -->
  <!-- <arg name="model" default="$(find myslam21)/urdf/myslam21.urdf"/> -->
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="odom_topic" default="odom" />
  <arg name="move_forward_only" default="false"/>
  <arg name="base_global_planner" default="navfn/NavfnROS"/>
  <arg name="base_local_planner" default="dwa_local_planner/DWAPlannerROS"/>

  <!-- move_base -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_global_planner" value="$(arg base_global_planner)"/>
    <param name="base_local_planner" value="$(arg base_local_planner)"/>
    <rosparam file="$(find mr_carter)/param/costmap_common_params_carter.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find mr_carter)/param/costmap_common_params_carter.yaml" command="load" ns="local_costmap" />
    <!-- <rosparam file="$(find mr_carter)/param/costmap_common.yaml" command="load" ns="global_costmap" /> -->
    <!-- <rosparam file="$(find mr_carter)/param/costmap_common.yaml" command="load" ns="local_costmap" /> -->
    <rosparam file="$(find mr_carter)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find mr_carter)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find mr_carter)/param/move_base_params.yaml" command="load" />
    <rosparam file="$(find mr_carter)/param/dwa_local_planner_params_carter.yaml" command="load" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <param name="DWAPlannerROS/min_vel_x" value="0.0" if="$(arg move_forward_only)" />
  </node>
</launch>
