<launch>
  <!-- Lowered from the D435's default profile (848x480@30 depth, 640x480@30
       color) on purpose: on this hardware the camera sits behind a USB3 hub
       built into the carrier board (confirmed via `lsusb -t` - there is no
       hub-free port to move it to), and that hub has shown isochronous
       streaming instability (control_transfer errors, uvc watchdog
       triggers, zero frames reaching RTAB-Map) at the full-bandwidth
       profile. Lower bandwidth is easier for marginal hub silicon to
       service reliably. To push it back up once/if stability is confirmed,
       either edit the defaults below, or test this file standalone with an
       override - these args aren't threaded through mapping.launch's/
       navigation.launch's include chain, so overrides only work directly
       against this file: roslaunch nexzino_nav realsense_bringup.launch
       depth_fps:=30 color_fps:=30 -->
  <arg name="depth_width" default="424" />
  <arg name="depth_height" default="240" />
  <arg name="depth_fps" default="15" />
  <arg name="color_width" default="424" />
  <arg name="color_height" default="240" />
  <arg name="color_fps" default="15" />

  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="camera" />
    <arg name="tf_prefix" value="camera" />
    <!-- true (was false): the depth/color/optical frame chain (camera_link
         -> camera_depth_frame -> camera_depth_optical_frame etc) now comes
         from the live driver's own factory-calibrated extrinsics instead of
         the static hand-typed numbers nexzino.urdf.xacro used to provide
         (use_nominal_extrinsics is now false by default there for exactly
         this reason - see nexzino.urdf.xacro's xacro:arg comment). The URDF
         still owns the RIGID MOUNT transform (base_link -> ... ->
         realsense_Link -> camera_link) - this only hands off the camera's
         own internal sensor geometry to the thing that actually measured it. -->
    <arg name="publish_tf" value="true" />
    <arg name="publish_odom_tf" value="false" />
    <arg name="align_depth" value="true" />
    <arg name="enable_pointcloud" value="true" />
    <arg name="enable_sync" value="true" />
    <arg name="filters" value="pointcloud" />
    <arg name="depth_width" value="$(arg depth_width)" />
    <arg name="depth_height" value="$(arg depth_height)" />
    <arg name="depth_fps" value="$(arg depth_fps)" />
    <arg name="color_width" value="$(arg color_width)" />
    <arg name="color_height" value="$(arg color_height)" />
    <arg name="color_fps" value="$(arg color_fps)" />
  </include>
</launch>
