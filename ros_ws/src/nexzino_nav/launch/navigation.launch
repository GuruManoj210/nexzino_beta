<launch>
  <arg name="simulation" default="false" />
  <arg name="database_path" default="$(env HOME)/.ros/nexzino_rtabmap.db" />
  <arg name="world" default="$(find nexzino_nav)/worlds/nexzino_navigation.world" />
  <arg name="open_rviz" default="true" />
  <arg name="start_base_bringup" default="true" />
  <!-- Set start_motor_driver:=false when diff_drive_controller.py is already
       running elsewhere (e.g. deploy/'s always-on services) - avoids a second
       process fighting over the same wheel controller serial port. -->
  <arg name="start_motor_driver" default="true" />
  <arg name="use_realsense" default="true" />
  <arg unless="$(arg simulation)" name="depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <arg if="$(arg simulation)" name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="rgb_topic" default="/camera/color/image_raw" />
  <arg name="camera_info_topic" default="/camera/color/camera_info" />

  <include if="$(arg start_base_bringup)"
           file="$(find nexzino_nav)/launch/bringup.launch">
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="world" value="$(arg world)" />
    <arg name="start_motor_driver" value="$(arg start_motor_driver)" />
    <arg name="use_realsense" value="$(arg use_realsense)" />
  </include>

  <include file="$(find nexzino_nav)/launch/rtabmap_localization.launch">
    <arg name="database_path" value="$(arg database_path)" />
    <arg name="rgb_topic" value="$(arg rgb_topic)" />
    <arg name="depth_topic" value="$(arg depth_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
  </include>

  <include file="$(find nexzino_nav)/launch/move_base.launch" />

  <node if="$(arg open_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find nexzino_nav)/config/nexzino_nav.rviz"
        output="screen" />
</launch>
