<launch>
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="odom_topic" default="/odom" />
  <arg name="move_forward_only" default="false" />
  <arg name="base_global_planner" default="navfn/NavfnROS" />
  <arg name="base_local_planner" default="dwa_local_planner/DWAPlannerROS" />

  <node pkg="move_base"
        type="move_base"
        name="move_base"
        output="screen"
        respawn="false">
    <param name="base_global_planner" value="$(arg base_global_planner)" />
    <param name="base_local_planner" value="$(arg base_local_planner)" />

    <rosparam file="$(find nexzino_nav)/config/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find nexzino_nav)/config/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find nexzino_nav)/config/global_costmap.yaml" command="load" />
    <rosparam file="$(find nexzino_nav)/config/local_costmap.yaml" command="load" />
    <rosparam file="$(find nexzino_nav)/config/move_base.yaml" command="load" />
    <rosparam file="$(find nexzino_nav)/config/dwa_local_planner.yaml" command="load" />

    <remap from="cmd_vel" to="$(arg cmd_vel_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
    <param name="DWAPlannerROS/min_vel_x" value="0.0" if="$(arg move_forward_only)" />
  </node>
</launch>
