    <!-- added from here -->
    <gazebo>
        <plugin filename="libgazebo_ros_control.so" name="gazebo_ros_control">
            <controlPeriod>0.001</controlPeriod>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="libroboticsgroup_gazebo_mimic_joint_plugin.so" name="lel_jmimic_joint_plugin">
            <joint>lep_j</joint>
            <mimicJoint>lel_j</mimicJoint>
            <multiplier>1.0</multiplier>
            <offset>0</offset>
            <sensitiveness>0.0</sensitiveness>
            <!-- if absolute difference between setpoint and process value is below this threshold, do nothing; 0.0 = disable [rad] -->
            <maxEffort>10.0</maxEffort>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="libroboticsgroup_gazebo_mimic_joint_plugin.so" name="rel_jmimic_joint_plugin">
            <joint>rep_j</joint>
            <mimicJoint>rel_j</mimicJoint>
            <multiplier>1.0</multiplier>
            <offset>0</offset>
            <sensitiveness>0.0</sensitiveness>
            <!-- if absolute difference between setpoint and process value is below this threshold, do nothing; 0.0 = disable [rad] -->
            <maxEffort>10.0</maxEffort>
        </plugin>
    </gazebo>
    <gazebo>
        <plugin filename="libroboticsgroup_gazebo_mimic_joint_plugin.so" name="lg2_jmimic_joint_plugin">
            <joint>lg1_j</joint>
            <mimicJoint>lg2_j</mimicJoint>
            <multiplier>-1.0</multiplier>
            <offset>0</offset>
            <sensitiveness>0.0</sensitiveness>
            <!-- if absolute difference between setpoint and process value is below this threshold, do nothing; 0.0 = disable [rad] -->
