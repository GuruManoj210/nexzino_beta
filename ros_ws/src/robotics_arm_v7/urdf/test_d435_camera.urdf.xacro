<?xml version="1.0" ?>
<robot name="realsense2_camera" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="name" default="camera" />
  <xacro:arg name="topics_ns" default="camera" />
  <xacro:arg name="use_nominal_extrinsics" default="true" />
  <xacro:arg name="publish_pointcloud" default="false" />
  <xacro:arg name="add_plug" default="false" />
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <xacro:sensor_d435i name="$(arg name)" topics_ns="$(arg topics_ns)" parent="realsenseh2_l" use_nominal_extrinsics="$(arg use_nominal_extrinsics)" publish_pointcloud="$(arg publish_pointcloud)" add_plug="$(arg add_plug)">
    <origin xyz="-0.0069921 -0.01016 0.0489" rpy="-1.5708 0 -0.36956"/>
  </xacro:sensor_d435i>
</robot>
