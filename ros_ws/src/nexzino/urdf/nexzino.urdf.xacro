<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro"
  name="nexzino">
  <xacro:arg name="use_gazebo" default="false" />
  <xacro:arg name="publish_pointcloud" default="true" />
  <!-- Default flipped from true: the depth/color/optical frame chain now
       comes from the live realsense2_camera driver's real calibrated
       extrinsics (publish_tf:=true in realsense_bringup.launch) instead of
       static guessed numbers. Still overridable to true for offline
       display.launch/Gazebo use where no driver is running to publish
       those frames dynamically. -->
  <xacro:arg name="use_nominal_extrinsics" default="false" />
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />
  <xacro:include filename="$(find nexzino)/urdf/nexzino.gazebo.xacro" />

  <link name="base_footprint"></link>
  <joint name="base_footprint_joint" type="fixed">
    <!-- base_footprint sits at true ground level (REP-120): wheel joints
         mount at z=-0.014999 relative to base_link, and diff_drive.yaml's
         wheel_radius is 0.105, so true wheel-ground contact is at base_link
         z = -0.014999 - 0.105 =~ -0.12. Offsetting base_link up by 0.12
         here puts base_footprint's z=0 back at actual ground level. -->
    <origin xyz="0 0 0.12" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <link
