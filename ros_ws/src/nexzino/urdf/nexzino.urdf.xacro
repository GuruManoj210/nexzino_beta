  <!-- Camera sensor frames attached directly at realsense_Link's own pose -
       zero extra rotation, zero extra offset. realsense_Link's mesh (a
       combined mount-arm + camera unit, confirmed visually against the
       real robot) IS the ground truth for where/how the camera sits; no
       hand-derived compensating rotation on top of it. (An earlier attempt
       to derive that compensating rotation mathematically produced a
       provably wrong result - the mesh mixes mount-arm and camera geometry,
       so its own axes can't be read off computationally either. This is
       the deliberate alternative: trust the CAD pose completely instead of
       guessing a correction for it.)
       Depth/color/optical frame orientations still come from the live
       camera driver's own calibrated extrinsics (realsense_bringup.launch's
       publish_tf:=true / use_nominal_extrinsics:=false), not static numbers
       here - use_nominal_extrinsics is kept as a fallback for offline
       display/Gazebo use where no live driver is publishing those frames. -->
  <xacro:sensor_d435
    parent="realsense_Link"
    name="camera"
    topics_ns="camera"
    use_nominal_extrinsics="$(arg use_nominal_extrinsics)"
    publish_pointcloud="$(arg publish_pointcloud)">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:sensor_d435>
  <link
    name="cameratop_Link">
    <inertial>
      <origin
        xyz="-0.00501711981331032 -1.07127451966994 5.50848912026225E-05"
