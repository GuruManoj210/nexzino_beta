# Copy this file to deploy/.env and fill in real paths for this specific
# robot. deploy/.env is gitignored - each robot pins its own devices here.
#
# Find stable paths with: ls -l /dev/serial/by-id/
# (raw paths like /dev/ttyACM0/ttyUSB0 can shuffle between reboots when
# multiple USB-serial adapters are plugged in - by-id paths don't.)

# ZLAC8015D hub motor / diff drive wheel controller.
WHEEL_CONTROLLER_PORT=/dev/serial/by-id/usb-ZLAC8015D_example-if00

# Feetech USB adapter for the arm servos (servo_tester).
SERVO_CONTROLLER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_example-if00
